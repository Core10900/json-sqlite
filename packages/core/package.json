{
  "name": "@webofcat/jsonsqlite",
  "version": "1.5.0",
  "description": "JSON-native embedded database for Node.js — production-ready: rekey, lazy load, vacuum, doctor",
  "license": "MIT",
  "author": "hanlin <lincent909@163.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Core10900/json-sqlite.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Core10900/json-sqlite#readme",
  "bugs": {
    "url": "https://github.com/Core10900/json-sqlite/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "jsonsqlite": "./dist/cli.js",
    "jsql": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "pnpm run build && pnpm test",
    "pack:smoke": "pnpm run build && node ./scripts/pack-smoke.mjs"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "database",
    "json",
    "embedded",
    "document-store",
    "nodejs",
    "wal",
    "jsonsqlite"
  ]
}
