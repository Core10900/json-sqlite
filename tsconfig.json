{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "packages/core/src/**/*",
    "packages/core/test/**/*"
  ],
  "exclude": [
    "**/node_modules",
    "**/dist"
  ]
}
